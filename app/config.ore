package main

import "std/net/http"
import "std/os"
import "std/time"

func listenAddress() string {
    let address = os.Getenv("ZORE_SITE_ADDR")
    if address == "" {
        return "0.0.0.0:8080"
    }
    return address
}

func serverConfig() http.Config {
    var config = http.DefaultConfig()
    config.MaxHeaderBytes = 16384
    config.MaxBodyBytes = 4096
    config.MaxConnections = 256
    config.ReadHeaderTimeout = 5 * time.Second
    config.ReadBodyTimeout = 5 * time.Second
    config.WriteTimeout = 10 * time.Second
    config.IdleTimeout = 15 * time.Second
    config.AcceptPollInterval = 50 * time.Millisecond
    config.ShutdownTimeout = 10 * time.Second
    return config
}
