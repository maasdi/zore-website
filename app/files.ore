package main

import "std/io"
import "std/net/http"
import "std/os"

func readSiteFile(file siteFile) (Array<byte>, error) {
    let info, statError = os.Stat(file.path)
    if statError != nil {
        return Array<byte>{}, statError
    }
    if info.IsDir() || info.Size() < 0 || info.Size() > file.maxBytes {
        return Array<byte>{}, error("website content has an invalid type or size: " + file.path)
    }
    let source, openError = os.Open(file.path)
    if openError != nil {
        return Array<byte>{}, openError
    }
    var data = Array<byte>{}
    var buffer = Array<byte>{}
    for var index = 0; index < 8192; index += 1 {
        buffer.push(0)
    }
    for {
        let count, readError = source.Read(buffer[:])
        if count < 0 || count > buffer.len() || data.len() + count > file.maxBytes {
            _ = readError
            return Array<byte>{}, error("website content exceeds its size limit: " + file.path)
        }
        for var index = 0; index < count; index += 1 {
            data.push(buffer[index])
        }
        if readError == io.EOF {
            return data, nil
        }
        if readError != nil {
            return Array<byte>{}, readError
        }
        if count == 0 {
            return Array<byte>{}, error("website content read made no progress: " + file.path)
        }
    }
}

func validateSiteFiles() error {
    let files = siteFiles()
    for file in files {
        let _, err = readSiteFile(file);
        if err != nil {
            return err
        }
    }
    return nil
}

func loadSiteFile(file siteFile, readiness siteReadiness) (Array<byte>, error) {
    let data, readError = readSiteFile(file)
    if readError != nil {
        readiness.revoke()
        logFailure("website content unavailable", readError)
        return Array<byte>{}, readError
    }
    return data, nil
}

func serveSiteFile(w mut http.ResponseWriter, file siteFile, readiness siteReadiness) error {
    let data, readError = loadSiteFile(file, readiness)
    if readError != nil {
        return writeText(w, 500, "text/plain; charset=utf-8", "no-store", "Internal server error\n")
    }
    setResponseHeaders(w, file.mediaType, file.cacheControl, data.len())?
    w.WriteHeader(200)?
    let _, err = w.Write(data[:])
    return err
}
