package main

import "std/context"
import "std/net/http"
import "std/os"
import "std/os/signal"
import "std/time"

func run() error {
    validateSiteFiles()?
    let selected = [signal.Signal; 2]{signal.Interrupt, signal.Terminate}
    let lifecycle, stop = signal.NotifyContext(context.Background(), selected[:])?
    let readiness = newReadiness(lifecycle)
    readiness.activate()
    let router, routerError = siteRouter(readiness)
    if routerError != nil {
        stop()
        return routerError
    }
    var address = os.Getenv("ZORE_SITE_ADDR")
    if address == "" {
        address = "0.0.0.0:8080"
    }
    var config = http.DefaultConfig()
    config.MaxHeaderBytes = 16384
    config.MaxBodyBytes = 4096
    config.MaxConnections = 256
    config.ReadHeaderTimeout = 5 * time.Second
    config.ReadBodyTimeout = 5 * time.Second
    config.WriteTimeout = 10 * time.Second
    config.IdleTimeout = 15 * time.Second
    config.AcceptPollInterval = 50 * time.Millisecond
    config.ShutdownTimeout = 10 * time.Second
    println("Starting Zore website on " + address)
    let serveError = http.ListenAndServeContext(lifecycle, address, router, config)
    readiness.revoke()
    stop()
    println("Zore website stopped")
    return serveError
}

func main() {
    let err = run()
    if err != nil {
        logFailure("website stopped with an error", err)
        os.Exit(1)
    }
}
