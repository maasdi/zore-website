package main

import "std/context"
import "std/net/http"
import "std/os"
import "std/os/signal"

func run() error {
    validateSiteFiles()?
    let selected = [signal.Signal; 2]{signal.Interrupt, signal.Terminate}
    let lifecycle, stop = signal.NotifyContext(context.Background(), selected[:])?
    let readiness = newReadiness(lifecycle)
    readiness.activate()
    let router, routerError = siteRouter(readiness)
    if routerError != nil {
        stop()
        return routerError
    }
    let address = listenAddress()
    let config = serverConfig()
    println("Starting Zore website on " + address)
    let serveError = http.ListenAndServeContext(lifecycle, address, router, config)
    readiness.revoke()
    stop()
    println("Zore website stopped")
    return serveError
}

func main() {
    let err = run()
    if err != nil {
        logFailure("website stopped with an error", err)
        os.Exit(1)
    }
}
